{
  "version": "2.1",
  "description": "Churn-risk features. Scales match the training run; changing one without retraining is train/serve skew.",
  "features": [
    {
      "name": "seats",
      "source": "seats",
      "kind": "numeric",
      "scale": 100.0,
      "clip_min": 0.0,
      "clip_max": 10.0
    },
    {
      "name": "monthly_spend",
      "source": "monthly_spend",
      "kind": "numeric",
      "scale": 1000.0,
      "clip_min": 0.0,
      "clip_max": 50.0
    },
    {
      "name": "tenure_days",
      "source": "tenure_days",
      "kind": "numeric",
      "default": 0,
      "scale": 365.0,
      "clip_min": 0.0,
      "clip_max": 10.0
    },
    {
      "name": "support_tickets",
      "source": "support_tickets",
      "kind": "numeric",
      "default": 0,
      "scale": 10.0,
      "clip_min": 0.0,
      "clip_max": 10.0
    },
    {
      "name": "has_sso",
      "source": "has_sso",
      "kind": "boolean",
      "default": false
    },
    {
      "name": "plan",
      "source": "plan",
      "kind": "categorical",
      "categories": ["free", "team", "enterprise"]
    }
  ]
}
