__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.env
.venv/
venv/

# The warehouse is derived state. Every table in it can be rebuilt from raw/ by
# `etlduck run`, so committing it would mean committing something that goes stale the
# moment anybody ingests anything.
warehouse/*.duckdb
warehouse/*.duckdb.wal

# Generated volume for the benchmark. The committed files under raw/ are small and are
# tracked; large synthetic batches belong in a scratch directory.
/tmp-seed/
