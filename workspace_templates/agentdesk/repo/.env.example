# Copy to .env before running docker compose by hand.
#
# The exercise harness generates a .env for you with ports allocated from 55000-55999,
# so several exercises can run at once without fighting over a port. These values are the
# defaults compose falls back to when no .env is present.

WS_POSTGRES_PORT=55433
WS_APP_PORT=55801

POSTGRES_DB=agentdesk
POSTGRES_USER=agentdesk
POSTGRES_PASSWORD=agentdesk
