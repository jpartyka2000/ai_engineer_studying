# Copy to .env and adjust. The harness generates a real .env at scaffold time with
# a host port allocated from 55000-55999, so you normally do not need to touch this.

# Host ports. Deliberately clear of 5432/6379/8000 so nothing collides with the
# study app's own services.
WS_POSTGRES_PORT=55432
WS_APP_PORT=55800

POSTGRES_DB=tenantsaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Container-to-container: db:5432, not the published port.
DATABASE_URL=postgresql://postgres:postgres@db:5432/tenantsaas

DEBUG=1
SECRET_KEY=dev-only-not-a-real-secret

# RDS deployment metadata. Amazon RDS is a managed service and cannot run locally,
# so the database is a plain Postgres container and these carry the operational
# details a real RDS deployment would have.
RDS_INSTANCE_IDENTIFIER=tenantsaas-prod-1
RDS_PARAMETER_GROUP=tenantsaas-pg16-custom
RDS_IAM_AUTH_ENABLED=true
RDS_READ_REPLICA_ENDPOINT=tenantsaas-prod-1-ro.local:5432
