# Copy to .env before running docker compose by hand.
#
# The exercise harness generates a .env for you with ports allocated from 55000-55999,
# so that several exercises can be running at once without fighting over a port. These
# values are the defaults compose falls back to when no .env is present.
#
# Only the PUBLISHED ports live here. Inside the compose network the app always reaches
# MongoDB at db:27017.

WS_MONGO_PORT=55017
WS_APP_PORT=55800

MONGO_DATABASE=eventstore
