__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.env
.venv/
venv/

# The warehouse is derived state. Every table in it can be rebuilt from the Mongo event
# stream by `eventstore rollup --full`, so committing it would mean committing something
# that goes stale the moment anybody ingests anything.
warehouse/*.duckdb
warehouse/*.duckdb.wal

# Scratch volume for the benchmark, which generates a large synthetic collection. The
# committed exports under data/ are small and are tracked.
/tmp-bench/
