# Copy to .env before running docker compose by hand.
#
# The exercise harness generates a .env for you with ports allocated from 55000-55999,
# so several exercises can run at once without fighting over a port. These values are
# the defaults compose falls back to when no .env is present.
#
# Only the PUBLISHED ports live here. Inside the compose network the app always reaches
# PostgreSQL at db:5432.

WS_POSTGRES_PORT=55432
WS_APP_PORT=55800

POSTGRES_DB=sqlgenie
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Development API keys, one per seeded tenant. These are fixtures, not secrets: the
# database stores only their SHA-256, and the whole dataset is synthetic.
#
#   curl -H "X-Api-Key: acme-dev-key" localhost:$WS_APP_PORT/v1/schema
#
# acme-dev-key -> tenant acme
# borg-dev-key -> tenant borg
